rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRequestManager() {
      return signedIn()
        && (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (exists(/databases/$(database)/documents/portalDirectory/$(request.auth.uid))
          && get(/databases/$(database)/documents/portalDirectory/$(request.auth.uid)).data.role == 'admin'
          && get(/databases/$(database)/documents/portalDirectory/$(request.auth.uid)).data.status == 'Active'));
    }

    function validStudentRequest() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'studentName', 'studentId', 'email', 'serviceId', 'serviceName',
          'description', 'requestDate', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'studentName', 'studentId', 'email', 'serviceId', 'serviceName',
          'description', 'requestDate', 'status', 'createdAt'
        ])
        && data.studentName is string
        && data.studentName.size() >= 3
        && !data.studentName.matches('^\\s*$')
        && data.studentName.size() <= 35
        && !data.studentName.matches('.*[0-9].*')
        && data.studentId is string
        && data.studentId.matches('^90101[0-9]{4}$')
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.serviceId in [
          'academic-transcript', 'recommendation-letter', 'registration-assistance',
          'student-id-replacement', 'technical-support', 'general-enquiry'
        ]
        && data.serviceName is string
        && data.serviceName.size() > 0
        && data.serviceName.size() <= 100
        && (
          (data.serviceId == 'academic-transcript' && data.serviceName == 'Academic Transcript Request')
          || (data.serviceId == 'recommendation-letter' && data.serviceName == 'Letter of Recommendation Request')
          || (data.serviceId == 'registration-assistance' && data.serviceName == 'Registration Assistance')
          || (data.serviceId == 'student-id-replacement' && data.serviceName == 'Student ID Replacement')
          || (data.serviceId == 'technical-support' && data.serviceName == 'Technical Support')
          || (data.serviceId == 'general-enquiry' && data.serviceName == 'General Enquiry')
        )
        && data.description is string
        && data.description.size() >= 10
        && data.description.size() <= 2000
        && !data.description.matches('^\\s*$')
        && data.requestDate is string
        && data.requestDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.status == 'Pending'
        && data.createdAt == request.time;
    }

    match /studentRequests/{requestId} {
      // Students may create only a schema-validated request; they cannot list or read student data.
      allow create: if validStudentRequest();
      allow get, list: if isRequestManager();
      allow update: if isRequestManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['Pending', 'In Progress', 'Completed', 'Rejected'];
      allow delete: if isRequestManager();
    }

    function validDirectoryProfile() {
      let p = request.resource.data;
      return p.keys().hasAll(['role','name','displayName','email','identifier','status'])
        && p.keys().hasOnly(['role','name','displayName','email','identifier','status','studentNumber','faculty','programme','year','index'])
        && p.role in ['student','lecturer','admin']
        && p.name is string && p.name.size() >= 3 && p.name.size() <= 80
        && p.displayName == p.name
        && p.email is string && p.email.size() <= 254
        && p.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+
      // A signed-in staff user may check their own administrator record only.
      // Provision this record through a trusted Firebase Console/Admin SDK workflow.
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
)
        && p.status in ['Active','Suspended']
        && ((p.role == 'student' && p.studentNumber is string && p.studentNumber.matches('^90101[0-9]{4}
      // A signed-in staff user may check their own administrator record only.
      // Provision this record through a trusted Firebase Console/Admin SDK workflow.
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
)
             && p.identifier == p.studentNumber && p.faculty in ['FICT','FCMB','FBMG','FCTH']
             && p.programme is string && p.programme.size() > 0 && p.programme.size() <= 120
             && p.year.matches('^Year [1-8]
      // A signed-in staff user may check their own administrator record only.
      // Provision this record through a trusted Firebase Console/Admin SDK workflow.
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
))
          || (p.role == 'lecturer' && p.identifier == p.email && p.faculty in ['FICT','FCMB','FBMG','FCTH'])
          || (p.role == 'admin' && p.identifier == p.email));
    }
    function lecturerCanRead() {
      return signedIn()
        && exists(/databases/$(database)/documents/portalDirectory/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalDirectory/$(request.auth.uid)).data.role == 'lecturer'
        && get(/databases/$(database)/documents/portalDirectory/$(request.auth.uid)).data.status == 'Active'
        && resource.data.role == 'student'
        && resource.data.faculty == get(/databases/$(database)/documents/portalDirectory/$(request.auth.uid)).data.faculty;
    }
    match /portalDirectory/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isRequestManager() || lecturerCanRead());
      allow list: if isRequestManager() || lecturerCanRead();
      allow create: if isRequestManager() && validDirectoryProfile();
      allow update: if isRequestManager() && validDirectoryProfile()
        && request.resource.data.email == resource.data.email
        && (request.auth.uid != userId || (request.resource.data.role == 'admin' && request.resource.data.status == 'Active'));
      allow delete: if isRequestManager() && request.auth.uid != userId;
    }

    match /admins/{userId} {
      // A signed-in staff user may check their own administrator record only.
      // Provision this record through a trusted Firebase Console/Admin SDK workflow.
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
