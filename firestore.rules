rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRequestManager() {
      return signedIn()
        && (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (exists(/databases/$(database)/documents/portalDirectory/$(request.auth.uid))
          && get(/databases/$(database)/documents/portalDirectory/$(request.auth.uid)).data.role == 'admin'
          && get(/databases/$(database)/documents/portalDirectory/$(request.auth.uid)).data.status == 'Active'));
    }

    function validStudentRequest() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'studentName', 'studentId', 'email', 'serviceId', 'serviceName',
          'description', 'requestDate', 'status', 'createdAt', 'ownerUid', 'fee', 'payment'
        ])
        && data.keys().hasOnly([
          'studentName', 'studentId', 'email', 'serviceId', 'serviceName',
          'description', 'requestDate', 'status', 'createdAt', 'ownerUid', 'fee', 'payment'
        ])
        && activeStudent()
        && data.ownerUid == request.auth.uid
        && data.studentId == studentProfile().studentNumber
        && data.email == studentProfile().email
        && data.studentName == studentProfile().name
        && data.payment is map && data.payment.keys().hasOnly(['status'])
        && ((data.serviceId == 'student-id-replacement' && data.fee == 450 && data.payment.status == 'Awaiting payment')
          || (data.serviceId != 'student-id-replacement' && data.fee == 0 && data.payment.status == 'Not required'))
        && data.studentName is string
        && data.studentName.size() >= 3
        && !data.studentName.matches('^\\s*$')
        && data.studentName.size() <= 80
        && !data.studentName.matches('.*[0-9].*')
        && data.studentId is string
        && data.studentId.matches('^90101[0-9]{4}$')
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.serviceId in [
          'academic-transcript', 'recommendation-letter', 'registration-assistance',
          'student-id-replacement', 'technical-support', 'general-enquiry'
        ]
        && data.serviceName is string
        && data.serviceName.size() > 0
        && data.serviceName.size() <= 100
        && (
          (data.serviceId == 'academic-transcript' && data.serviceName == 'Academic Transcript Request')
          || (data.serviceId == 'recommendation-letter' && data.serviceName == 'Letter of Recommendation Request')
          || (data.serviceId == 'registration-assistance' && data.serviceName == 'Registration Assistance')
          || (data.serviceId == 'student-id-replacement' && data.serviceName == 'Student ID Replacement')
          || (data.serviceId == 'technical-support' && data.serviceName == 'Technical Support')
          || (data.serviceId == 'general-enquiry' && data.serviceName == 'General Enquiry')
        )
        && data.description is string
        && data.description.size() >= 10
        && data.description.size() <= 2000
        && !data.description.matches('^\\s*$')
        && data.requestDate is string
        && data.requestDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.status == 'Pending'
        && data.createdAt == request.time;
    }

    function studentProfile() {
      return get(/databases/$(database)/documents/portalDirectory/$(request.auth.uid)).data;
    }
    function activeStudent() {
      return signedIn() && exists(/databases/$(database)/documents/portalDirectory/$(request.auth.uid))
        && studentProfile().role == 'student' && studentProfile().status == 'Active';
    }
    function ownsRequest() {
      return activeStudent() && resource.data.ownerUid == request.auth.uid;
    }
    function pricedCard() {
      return resource.data.serviceId == 'student-id-replacement' && resource.data.get('fee',0) == 450;
    }
    function validProof() {
      let p = request.resource.data.payment;
      return p is map && p.keys().hasAll(['status','reference','proofName','proofType','proofData','submittedAt'])
        && p.keys().hasOnly(['status','reference','proofName','proofType','proofData','submittedAt'])
        && p.status == 'Pending verification'
        && p.reference is string && p.reference.size() >= 3 && p.reference.size() <= 100
        && p.proofName is string && p.proofName.size() > 0 && p.proofName.size() <= 120
        && p.proofType in ['application/pdf','image/jpeg','image/png','image/webp']
        && p.proofData is string && p.proofData.size() > 0 && p.proofData.size() <= 546136
        && p.submittedAt == request.time;
    }
    function validPaymentReview(requestId) {
      let p = request.resource.data.payment;
      return pricedCard() && resource.data.status != 'Rejected'
        && resource.data.payment.status == 'Pending verification'
        && p.diff(resource.data.payment).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy','receiptNumber','rejectionReason'])
        && p.reviewedAt == request.time && p.reviewedBy == request.auth.uid
        && ((p.status == 'Verified' && p.receiptNumber == 'LIM-' + requestId && !p.keys().hasAny(['rejectionReason']))
          || (p.status == 'Payment rejected' && p.rejectionReason is string && p.rejectionReason.size() >= 3
            && p.rejectionReason.size() <= 300 && !p.keys().hasAny(['receiptNumber'])));
    }
    match /studentRequests/{requestId} {
      allow create: if validStudentRequest();
      allow get, list: if isRequestManager() || ownsRequest();
      allow update: if (ownsRequest() && pricedCard() && resource.data.status != 'Rejected'
          && resource.data.payment.status in ['Awaiting payment','Payment rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payment']) && validProof())
        || (isRequestManager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payment'])
          && validPaymentReview(requestId))
        || (isRequestManager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['Pending','In Progress','Completed','Rejected']
          && (!pricedCard() || resource.data.payment.status == 'Verified' && request.resource.data.status != 'Rejected'
            || resource.data.payment.status in ['Awaiting payment','Payment rejected'] && request.resource.data.status in ['Pending','Rejected']));
      allow delete: if isRequestManager() && (!pricedCard() || resource.data.payment.status == 'Awaiting payment');
    }

    function validDirectoryProfile() {
      let p = request.resource.data;
      return p.keys().hasAll(['role','name','displayName','email','identifier','status'])
        && p.keys().hasOnly(['role','name','displayName','email','identifier','status','studentNumber','faculty','programme','year','index'])
        && p.role in ['student','lecturer','admin']
        && p.name is string && p.name.size() >= 3 && p.name.size() <= 80
        && p.displayName == p.name
        && p.email is string && p.email.size() <= 254
        && p.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && p.status in ['Active','Suspended']
        && ((p.role == 'student' && p.studentNumber is string && p.studentNumber.matches('^90101[0-9]{4}$')
             && p.identifier == p.studentNumber && p.faculty in ['FICT','FCMB','FBMG','FCTH']
             && p.programme is string && p.programme.size() > 0 && p.programme.size() <= 120
             && p.year is string && p.year.matches('^Year [1-8]$'))
          || (p.role == 'lecturer' && p.identifier == p.email && p.faculty in ['FICT','FCMB','FBMG','FCTH']
              && !p.keys().hasAny(['studentNumber','programme','year']))
          || (p.role == 'admin' && p.identifier == p.email
              && !p.keys().hasAny(['studentNumber','programme','year','faculty','index'])));
    }
    function lecturerCanRead() {
      return signedIn()
        && exists(/databases/$(database)/documents/portalDirectory/$(request.auth.uid))
        && get(/databases/$(database)/documents/portalDirectory/$(request.auth.uid)).data.role == 'lecturer'
        && get(/databases/$(database)/documents/portalDirectory/$(request.auth.uid)).data.status == 'Active'
        && resource.data.role == 'student'
        && resource.data.faculty == get(/databases/$(database)/documents/portalDirectory/$(request.auth.uid)).data.faculty;
    }
    match /portalDirectory/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isRequestManager() || lecturerCanRead());
      allow list: if isRequestManager() || lecturerCanRead();
      allow create: if isRequestManager() && validDirectoryProfile();
      allow update: if isRequestManager() && validDirectoryProfile()
        && request.resource.data.email == resource.data.email
        && (request.auth.uid != userId || (request.resource.data.role == 'admin' && request.resource.data.status == 'Active'));
      allow delete: if isRequestManager() && request.auth.uid != userId;
    }

    match /admins/{userId} {
      // A signed-in staff user may check their own administrator record only.
      // Provision this record through a trusted Firebase Console/Admin SDK workflow.
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
